#!/usr/bin/env bash
# A timer that makes an audible sound after the time's up.
#
# author: andreasl

show_usage() {
    echo "Usage: ${0##*/} [-H <hours>] [-m <minutes>] [-s <seconds>] [--alt-melody] [--quiet]"
    echo "  -H, --hours      Set hours"
    echo "  -m, --minutes    Set minutes"
    echo "  -s, --seconds    Set seconds"
    echo "  -a, --alt-melody Use alternative melody"
    echo "  -t, --time       Set alarm for clock time (HH:MM or HH:MM:SS)"
    echo "  -q, --quiet      Quiet mode"
    echo "  -h, --help       Show this help"
}

[ "$#" -eq 0 ] && {
    show_usage
    exit 1
}

hours=0
minutes=0
seconds=0
quiet=false
alt_melody=false
target_time=
while [ "$#" -gt 0 ]; do
    case "$1" in
    -H | --hours)
        hours="$2"
        shift
        ;;
    -m | --minutes)
        minutes="$2"
        shift
        ;;
    -s | --seconds)
        seconds="$2"
        shift
        ;;
    -q | --quiet)
        quiet=true
        ;;
    -a | --alt-melody)
        alt_melody=true
        ;;
    -t | --time)
        target_time="$2"
        shift
        ;;
    -h | --help)
        show_usage
        exit 0
        ;;
    *)
        [ "$hours" -eq 0 ] && [ "$minutes" -eq 0 ] && [ "$seconds" -eq 0 ] && seconds="$1"
        ;;
    esac
    shift
done

print() { [ "$quiet" != true ] && printf "%b" "$1"; }

if [ -n "$target_time" ]; then
    # if absolute time is set via `-t` or `--time`
    # GNU `date` is `gdate` on macOS (coreutils via brew) and plain `date` on Linux
    date_cmd="$(command -v gdate || command -v date)"
    target_timestamp="$("$date_cmd" -d "$target_time" +%s)"
    [ -z "$target_timestamp" ] && exit 2
    now="$(date +%s)"
    [ "$target_timestamp" -le "$now" ] && target_timestamp="$("$date_cmd" -d "tomorrow ${target_time}" +%s)"
    remaining=$((target_timestamp - now))
else
    # if relative time is set via `-h`, `-m` and `-s`
    remaining=$((hours * 3600 + minutes * 60 + seconds))
fi

while [ "$remaining" -ge 5 ]; do
    print "${remaining}..."
    sleep 5
    remaining=$((remaining - 5))
done
print "${remaining}..."
sleep "$remaining"

notes=(440 554 659 880 659 554 440)
[ "$alt_melody" == true ] && notes=(880 698 587 523 587)

print "Time's up!\n"

# -f lavfi:   the input is a filtergraph, not a file
# -i "...":   the graph itself
# -nodisp:    no video window
# -autoexit:  quit when the audio ends, otherwise ffplay sits there
ffplay -nodisp -autoexit -f lavfi -i "$(
    for i in "${!notes[@]}"; do printf 'sine=frequency=%s:duration=0.2[a%s];' "${notes[$i]}" "$i"; done
    printf '[a%s]' "${!notes[@]}"
    printf 'concat=n=%s:v=0:a=1' "${#notes[@]}"
)" >/dev/null 2>&1
